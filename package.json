{
  "name": "principal-agentic-engineering-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Clean Architecture MCP + Agent Skills harness with agentic task orchestration and localhost browser QA.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test dist/tests/*.test.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "skills:sync": "node scripts/sync-skills.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run validate:catalog"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
